# Copy this file to .env.local and fill in the real values (never commit .env.local).
# Supabase Dashboard → Project Settings → Data API / API Keys

# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe to expose in the browser — data is protected by RLS.
# NEVER put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
